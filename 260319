import sys
from itertools import combinations
n = int(input())
num = [0,1,2,5]
dp= [0] * (n+1)
def initial():
    for i in range(n+1):
        dp[i] = 0

    dp[0] = 1

initial()

for i in range(1,n+1):
    for j in range(1,len(num)) :
        if i >=num[j]:
            if dp[i-num[j]] == 0:
                continue
            dp[i] += dp[i-num[j]]

ans = dp[n]

if ans == 0:
    ans = -1
else:
    print(ans%10007)
